# Banco de dados
# Produção: URL do PostgreSQL (Supabase, Neon...). Em branco = PGlite local em ./.data (só desenvolvimento).
DATABASE_URL=

# Acesso ao painel (/admin). Senha com 12+ caracteres. Nunca commitar valores reais.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo da sessão do painel (32+ caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=

# Fotos em produção (Vercel Blob). Em branco = salva em public/uploads (só desenvolvimento).
BLOB_READ_WRITE_TOKEN=
